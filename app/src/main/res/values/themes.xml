<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.MulberryDiseaseClassifier" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Primary colors -->
        <item name="colorPrimary">@color/sage_green</item>
        <item name="colorPrimaryVariant">@color/sage_green_dark</item>
        <item name="colorOnPrimary">@color/cream_card</item>

        <!-- Secondary colors -->
        <item name="colorSecondary">@color/sage_green_light</item>
        <item name="colorSecondaryVariant">@color/sage_green</item>
        <item name="colorOnSecondary">@color/text_primary</item>

        <!-- Background colors -->
        <item name="android:windowBackground">@color/cream_background</item>
        <item name="backgroundColor">@color/cream_background</item>

        <!-- Status bar -->
        <item name="android:statusBarColor">@color/cream_background</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- Navigation bar -->
        <item name="android:navigationBarColor">@color/cream_card</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>


    <style name="TextViewA" parent="Widget.MaterialComponents.TextView">
        <item name="android:textSize">22dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/goblin_one</item>
        <item name="android:textColor">@color/saddle_brown</item>
        <item name="android:background">@drawable/button_bordered</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:padding">8dp</item>
        <item name="android:gravity">center</item>

    </style>

    <style name="TextViewB" parent="Widget.MaterialComponents.TextView">
        <item name="android:textSize">18dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/montserrat_bold</item>
        <item name="android:textColor">@color/dark_slate_blue</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:gravity">center</item>

    </style>

    <style name="TextViewC" parent="Widget.MaterialComponents.TextView">
        <item name="android:textSize">18dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/goblin_one</item>
        <item name="android:textColor">@color/purple</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:gravity">center</item>

    </style>

    <style name="TextViewD" parent="Widget.MaterialComponents.TextView">
        <item name="android:textSize">22dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/lalezar</item>
        <item name="android:textColor">@color/salmon</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:gravity">center</item>

    </style>

    <style name="TextViewE" parent="Widget.MaterialComponents.TextView">
        <item name="android:textSize">22dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/lalezar</item>
        <item name="android:textColor">@color/dark_slate_gray</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:gravity">center</item>
    </style>
</resources>