<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="32dp"
        android:paddingBottom="24dp">

        <!-- Decorative circle background -->
        <View
            android:id="@+id/circle_bg_outer"
            android:layout_width="240dp"
            android:layout_height="240dp"
            android:layout_marginTop="40dp"
            android:background="@drawable/icon_circle_bg_large"
            android:alpha="0.6"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Main icon with circular background -->
        <FrameLayout
            android:id="@+id/icon_container"
            android:layout_width="160dp"
            android:layout_height="160dp"
            app:layout_constraintTop_toTopOf="@id/circle_bg_outer"
            app:layout_constraintBottom_toBottomOf="@id/circle_bg_outer"
            app:layout_constraintStart_toStartOf="@id/circle_bg_outer"
            app:layout_constraintEnd_toEndOf="@id/circle_bg_outer">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/icon_circle_bg"/>

            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_rocket_launch"
                android:scaleType="fitCenter"/>

        </FrameLayout>

        <!-- Title with elegant typography -->
        <TextView
            android:id="@+id/slide_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/onboarding_slide3_title"
            android:textSize="28sp"
            android:textColor="@color/text_primary"
            android:fontFamily="@font/montserrat_bold"
            android:textAlignment="center"
            android:letterSpacing="-0.01"
            android:layout_marginTop="48dp"
            app:layout_constraintTop_toBottomOf="@id/circle_bg_outer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Subtle divider accent -->
        <View
            android:id="@+id/divider"
            android:layout_width="40dp"
            android:layout_height="3dp"
            android:background="@color/coral_primary"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/slide_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Description with better readability -->
        <TextView
            android:id="@+id/slide_description"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/onboarding_slide3_desc"
            android:textSize="16sp"
            android:textColor="@color/text_secondary"
            android:fontFamily="@font/montserrat"
            android:textAlignment="center"
            android:lineSpacingMultiplier="1.4"
            android:layout_marginTop="20dp"
            android:layout_marginHorizontal="8dp"
            app:layout_constraintTop_toBottomOf="@id/divider"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>
