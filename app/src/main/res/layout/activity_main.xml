<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!-- Background Image -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/leaf_background"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <!-- Content Layer -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <!-- Premium Badge (top-right) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/premium_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="@color/cream_card"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_baseline_arrow_back_24"
                app:tint="@color/accent_warning"
                android:rotation="180"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Premium"
                android:textSize="12sp"
                android:textColor="@color/text_primary"
                android:fontFamily="@font/montserrat_bold"
                android:layout_marginStart="4dp"/>
        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- Main Content -->
    <LinearLayout
        android:id="@+id/main_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center"
        app:layout_constraintBottom_toTopOf="@id/bottom_navigation"
        app:layout_constraintTop_toBottomOf="@id/premium_badge"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Hero Text -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Define a disease\nin 1 click"
            android:textSize="32sp"
            android:textColor="@color/text_primary"
            android:fontFamily="@font/montserrat_bold"
            android:gravity="center"
            android:lineSpacingMultiplier="1.2"
            android:layout_marginBottom="40dp"/>

        <!-- Scan Plant Button (Primary) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnScanPlant"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Scan Plant"
            android:textColor="@color/cream_card"
            android:textSize="16sp"
            android:fontFamily="@font/montserrat_bold"
            android:layout_marginBottom="16dp"
            android:layout_marginHorizontal="16dp"
            android:backgroundTint="@color/sage_green"
            app:cornerRadius="28dp"
            app:elevation="2dp"/>

        <!-- Load Images Button (Secondary) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/loadImages"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Load Images"
            android:textColor="@color/sage_green"
            android:textSize="16sp"
            android:fontFamily="@font/montserrat_bold"
            android:layout_marginHorizontal="16dp"
            android:backgroundTint="@color/cream_card"
            app:strokeColor="@color/sage_green"
            app:strokeWidth="2dp"
            app:cornerRadius="28dp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>

    </LinearLayout>

    <!-- Bottom Navigation Bar -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/cream_card"
        app:elevation="8dp"
        app:itemIconTint="@color/sage_green"
        app:itemTextColor="@color/text_secondary"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_navigation_menu"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>
