<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream_background"
    android:padding="32dp">

    <!-- Illustration -->
    <ImageView
        android:id="@+id/slide_illustration"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:src="@drawable/mulberry"
        android:scaleType="fitCenter"
        app:tint="@color/sage_green"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/slide_title"
        app:layout_constraintVertical_chainStyle="packed"/>

    <!-- Title -->
    <TextView
        android:id="@+id/slide_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/onboarding_slide1_title"
        android:textSize="28sp"
        android:textColor="@color/text_primary"
        android:fontFamily="@font/montserrat_bold"
        android:textAlignment="center"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toBottomOf="@id/slide_illustration"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/slide_description"/>

    <!-- Description -->
    <TextView
        android:id="@+id/slide_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/onboarding_slide1_desc"
        android:textSize="16sp"
        android:textColor="@color/text_secondary"
        android:fontFamily="@font/montserrat"
        android:textAlignment="center"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/slide_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
